# Copy to .env (never commit it).
# Bootstrap token: only used once, to create the first administrator account in the web UI.
# After that, everyone signs in with their own account (roles: admin, operator, viewer).
ADMIN_TOKEN=
# 32-byte key (64 hex chars, e.g. `openssl rand -hex 32`) that encrypts stored credentials and TOTP seeds.
# If empty, a 0600 key file is generated in DATA_DIR — keep it out of backups that leave the server.
BERRIE_MASTER_KEY=
# Session lifetime and idle timeout.
SESSION_DAYS=7
SESSION_IDLE_HOURS=24
# Token for POST /api/ingest/events (e.g. n8n webhooks). Leave empty to disable ingestion.
INGEST_TOKEN=
# Container operations (start/stop/restart). Also set PROXY_ALLOW_POST=1 for the socket proxy.
ENABLE_ACTIONS=false
PROXY_ALLOW_POST=0
# Set true when served over HTTPS (e.g. via Cloudflare Tunnel) so cookies are Secure.
SECURE_COOKIES=false
# Trust X-Forwarded-For from a reverse proxy/tunnel for rate limiting and audit IPs.
TRUST_PROXY=false
BERRIE_PORT=4780
LOG_LEVEL=info
