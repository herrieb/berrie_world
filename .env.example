# Copy to .env (never commit it).
# Long random token for admin sign-in (logs, rename, layout editing, actions). Leave empty for read-only.
ADMIN_TOKEN=
# Token for POST /api/ingest/events (e.g. n8n webhooks). Leave empty to disable ingestion.
INGEST_TOKEN=
# Container operations (start/stop/restart). Also set PROXY_ALLOW_POST=1 for the socket proxy.
ENABLE_ACTIONS=false
PROXY_ALLOW_POST=0
# Set true when served over HTTPS (e.g. via Cloudflare Tunnel) so cookies are Secure.
SECURE_COOKIES=false
# Require admin sign-in even to view the world (recommended for any non-LAN exposure).
REQUIRE_AUTH_FOR_VIEW=false
# Trust X-Forwarded-For from a reverse proxy/tunnel for rate limiting and audit IPs.
TRUST_PROXY=false
BERRIE_PORT=4780
LOG_LEVEL=info
