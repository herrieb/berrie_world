{
  "name": "@berrie/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "DATA_DIR=${DATA_DIR:-../data} CONFIG_PATH=${CONFIG_PATH:-../config/berrie.config.json} tsx watch --clear-screen=false src/main.ts",
    "build": "esbuild src/main.ts src/cli.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist --packages=external --alias:@berrie/shared=../shared/src/index.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@berrie/shared": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.5",
    "ssh2": "^1.16.0",
    "yaml": "^2.9.1"
  }
}
